# Local development only; set secrets and HTTPS provider URLs for a deployment.
APP_NAME=Payment Service
APP_ENV=local
DEBUG=false
API_KEY=payments-local-development-key-only
API_PORT=18080
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments-local
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://payments:payments-local@127.0.0.1:15432/payments
DOCKER_DATABASE_URL=postgresql+asyncpg://payments:payments-local@db:5432/payments
PAYMENT_GATEWAY_URL=http://127.0.0.1:18081/mock-gateway
DOCKER_PAYMENT_GATEWAY_URL=http://mock-gateway:8001/mock-gateway
GATEWAY_TIMEOUT_SECONDS=5
GATEWAY_MAX_ATTEMPTS=5
GATEWAY_IDEMPOTENCY_NAMESPACE=payments-local
GATEWAY_BACKOFF_BASE_SECONDS=1
GATEWAY_BACKOFF_MAX_SECONDS=60
GATEWAY_BACKOFF_JITTER_SECONDS=0.5
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments-local
RABBITMQ_PORT=15673
RABBITMQ_MANAGEMENT_PORT=15674
CELERY_BROKER_URL=amqp://payments:payments-local@127.0.0.1:15673//
DOCKER_CELERY_BROKER_URL=amqp://payments:payments-local@rabbitmq:5672//
CELERY_TASK_TIME_LIMIT_SECONDS=60
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=45
WORKER_PROCESSING_TIMEOUT_SECONDS=90
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=100
OUTBOX_PUBLISH_TIMEOUT_SECONDS=10
MOCK_GATEWAY_PORT=18081
LOG_LEVEL=INFO
TRANSACTION_FEE=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
AUTO_CREATE_TABLES=false
